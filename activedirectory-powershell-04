[Create directory]
New-Item -ItemType Directory -Name "TestFolder"

[Create file]
New-Item -ItemType File -Name "test.txt"

[Read a text file]
Get-Content .\test.txt

[Copy something]
Copy-Item .\test.txt .\Backup\

[Move/rename]
Move-Item .\test.txt .\TestFolder\

[Delete]
Remove-Item .\test.txt

[Find commands]
Get-Command *ADUser*

[Learn how a command works]
Get-Help Get-ADUser -Examples



[Creating a new user]
    New-ADUser `
        -Name "John Smith" `
        -GivenName "John" `
        -Surname "Smith" `
        -SamAccountName "jsmith" `
        -UserPrincipalName "jsmith@aden.local" `
        -Path "OU=Users,OU=USA,DC=aden,DC=local" `
        -AccountPassword (ConvertTo-SecureString 'TempLab!2026#User' -AsPlainText -Force) `
        -Enabled $true `
        -ChangePasswordAtLogon $true


[Reset Password as Admin]
Set-ADAccountPassword -Identity asvay -Reset -NewPassword (ConvertTo-SecureString "TempPassword123!" -AsPlainText -Force)



















